<% module_namespacing do -%>
class <%= class_name %>Action < Promotable::Actions::Base
<% if parsed_preferences.any? -%>
  store_accessor :preferences, <%= parsed_preferences.map { |p| ":#{p[:name]}" }.join(", ") %>

<% end -%>
  def self.preference_fields
    [<%= parsed_preferences.map { |p| "{ name: :#{p[:name]}, type: :#{p[:type]} }" }.join(", ") %>]
  end

  def compute_amount(promotable, context = {})
    # TODO: calculate the discount amount (return a negative number for discounts)
    raise NotImplementedError
  end

  def apply(promotable, context = {})
    discount = compute_amount(promotable, context)
    return if discount.zero?

    create_adjustment(promotable, discount,
      label: "<%= class_name.underscore.humanize %>")
  end
end
<% end -%>
